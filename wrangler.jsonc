{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canopy-api-mcp",
  "main": "worker-entry.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "routes": [{ "pattern": "mcp.canopyapi.co", "custom_domain": true }]
    }
  }
}
