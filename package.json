{
  "name": "canopy-api-mcp",
  "version": "0.0.1",
  "description": "Canopy (built with ModelFetch)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
