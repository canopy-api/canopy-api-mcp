{
  "name": "canopy-api-mcp",
  "version": "2.1.0",
  "description": "Canopy MCP server (xmcp + Cloudflare Workers)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:widgets": "node scripts/build-widgets.mjs",
    "build": "npm run build:widgets && xmcp build --cf",
    "dev": "npm run build && concurrently \"xmcp dev --cf\" \"wrangler dev\"",
    "deploy": "npm run build && wrangler deploy --env production",
    "delete": "wrangler delete",
    "generate": "openapi-typescript https://rest.canopyapi.co/api/v1/openapi.json --output src/types/api.d.ts",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.10",
    "xmcp": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@openapitools/openapi-generator-cli": "^2.21.4",
    "@xmcp-dev/compiler": "^1.1.1",
    "concurrently": "^9.2.0",
    "esbuild": "^0.27.3",
    "openapi-typescript": "^7.8.0",
    "typescript": "5.8.3",
    "wrangler": "^4.27.0"
  }
}
