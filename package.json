{
  "name": "canopy-api-mcp",
  "version": "2.1.0",
  "description": "Canopy MCP server (xmcp + Cloudflare Workers)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:widgets": "node scripts/build-widgets.mjs",
    "build": "npm run build:widgets && xmcp build --cf",
    "dev": "npm run build && concurrently \"xmcp dev --cf\" \"wrangler dev\"",
    "deploy": "npm run build && wrangler deploy --env production",
    "delete": "wrangler delete",
    "generate": "openapi-typescript https://rest.canopyapi.co/api/v1/openapi.json --output src/types/api.d.ts",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jose": "^6.2.12",
    "xmcp": "^1.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@xmcp-dev/compiler": "^1.9.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "5.8.3",
    "wrangler": "^4.152.0"
  }
}
